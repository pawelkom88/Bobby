{
  "name": "bobby",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "emulator": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "emulator:kill": "pkill -f 'firebase emulators' || echo 'No emulator processes found'",
