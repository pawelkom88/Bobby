# ElevenLabs Agents Platform Configuration
# Copy this file to .env.local and fill in your actual values

# ===== CLIENT-SIDE VARIABLES (safe to expose) =====

# Your ElevenLabs Agent ID (required)
# Get your agent ID from: https://elevenlabs.io/dashboard/agents
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_agent_id_here

# ===== SERVER-SIDE VARIABLES (NEVER expose to client) =====

# ElevenLabs API Key (SECURE - server-side only)
# Get from: https://elevenlabs.io/dashboard/account/api-keys
# NEVER use NEXT_PUBLIC_ prefix for API keys!
# Reference: https://elevenlabs.io/docs/agents-platform/customization/authentication
ELEVENLABS_API_KEY=sk_xxxxx

# ElevenLabs Agent ID (server-side, for signed URL generation)
ELEVENLABS_AGENT_ID=your_agent_id_here

# Allowed origins for signed URL generation (comma-separated)
# Only these domains can request signed URLs from /api/get-signed-url
# For development: http://localhost:3000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# ===== OPTIONAL CONFIGURATION =====

# Environment: development or production
NODE_ENV=development
